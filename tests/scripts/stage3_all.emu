# ===== Тест команд этапов 1-3 (ls, cd — заглушки; exit — настоящая) =====
# ----- переменные окружения (EMU_DEMO задаёт ОС-скрипт)
ls $EMU_DEMO
ls ${EMU_DEMO}/sub
ls '$EMU_DEMO'
ls $NO_SUCH_VAR_XYZ
